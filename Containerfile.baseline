# Same application image without an InstantOn checkpoint.
# Use it only for the startup-time comparison. Deploy it with --set instanton.enabled=false.

FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /src
COPY pom.xml .
COPY src ./src
RUN mvn -B -DskipTests package

FROM icr.io/appcafe/open-liberty:kernel-slim-java17-openj9-ubi

COPY --chown=1001:0 src/main/liberty/config/server.xml /config/server.xml
RUN features.sh

COPY --chown=1001:0 --from=build /src/target/instanton-demo.war /config/apps/
RUN configure.sh
